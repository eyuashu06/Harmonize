# ============================================================
# HarmonyHub — environment variables
# Copy to .env and fill in real values. Do NOT commit .env.
# ============================================================

# ----- General -----
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_APP_NAME=HarmonyHub
PUBLIC_APP_URL=http://localhost:3000

# ----- Postgres -----
POSTGRES_USER=harmonyhub
POSTGRES_PASSWORD=harmonyhub_dev_pw
POSTGRES_DB=harmonyhub
DATABASE_URL=postgresql+psycopg://harmonyhub:harmonyhub_dev_pw@postgres:5432/harmonyhub

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Backend (FastAPI) -----
API_HOST=0.0.0.0
API_PORT=8001
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change-me-in-prod-please-use-openssl-rand-base64-48
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# Firebase Admin SDK (server-side verification of ID tokens)
# Path is mounted into the api container at /run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_HOST_PATH=
FIREBASE_PROJECT_ID=your-firebase-project-id

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ----- Storage -----
UPLOAD_DIR=/data/uploads
ANALYSIS_DIR=/data/analysis
MAX_UPLOAD_MB=64
